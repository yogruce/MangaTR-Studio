# ============================================================================
# MangaTR-Studio — Ortam Değişkenleri & Opsiyonel API Yapılandırması (.env)
# ============================================================================
# NOT: Bu projeyi çalıştırmak için herhangi bir API anahtarına İHTİYACINIZ YOKTUR!
# Varsayılan "auto" ve "free_web" modları tamamen ücretsiz ve API anahtarsız çalışır.
#
# Eğer isteğe bağlı olarak Google Gemini API, OpenAI/DeepSeek/OpenRouter API veya
# yerel Ollama LLM kullanmak isterseniz:
# 1. Bu dosyayı `.env` adıyla kopyalayın:  copy .env.example .env
# 2. Aşağıdaki ilgili alanları doldurun (veya uygulama içindeki "🔑 API Ayarları" penceresini kullanın).
# ============================================================================

# Çeviri Motoru Seçimi:
# - auto       : Önce yerel LLM / varsa API anahtarını dener, yoksa ücretsiz manga çeviri motorunu kullanır (Önerilen)
# - free_web   : %100 Ücretsiz, API anahtarsız manga yerelleştirme motoru
# - local_llm  : %100 Çevrimdışı yerel Ollama LLM (API anahtarı gerekmez)
# - gemini_api : Google Gemini API (Aşağıya GEMINI_API_KEY girilmelidir)
# - openai_api : OpenAI / DeepSeek / OpenRouter API (Aşağıya OPENAI_API_KEY girilmelidir)
MANGATR_BACKEND=auto

# --- 1. Google Gemini API (Opsiyonel) ---
# Anahtar almak için: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 2. OpenAI / DeepSeek / OpenRouter / LM Studio API (Opsiyonel) ---
# OpenAI için: https://api.openai.com/v1/chat/completions
# DeepSeek için: https://api.deepseek.com/v1/chat/completions
# OpenRouter için: https://openrouter.ai/api/v1/chat/completions
OPENAI_API_KEY=
OPENAI_COMPAT_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# --- 3. Yerel LLM - Ollama (Opsiyonel & Ücretsiz Çevrimdışı) ---
# Ollama kuruluysa (https://ollama.com): `ollama pull qwen2.5:7b`
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
